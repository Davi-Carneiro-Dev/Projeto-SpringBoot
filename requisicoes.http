@baseUrl = http://localhost:8080
@vagaId = 1
@empresaSlug = empresa-exemplo

### Criar empresa
POST {{baseUrl}}/empresas
Content-Type: application/json

{
  "nome": "Empresa Exemplo",
  "slug": "{{empresaSlug}}",
  "site": "https://empresa-exemplo.com.br",
  "descricao": "Empresa especializada no desenvolvimento de produtos digitais."
}

### Listar empresas
GET {{baseUrl}}/empresas

### Consultar perfil público da empresa
GET {{baseUrl}}/empresas/{{empresaSlug}}

### Criar vaga
POST {{baseUrl}}/vagas
Content-Type: application/json

{
  "titulo": "Pessoa Desenvolvedora Java",
  "descricao": "Desenvolvimento e manutenção de APIs REST com Spring Boot.",
  "area": "BACK_END",
  "senioridade": "JUNIOR",
  "local": "Remoto",
  "aceitaIniciante": true,
  "empresaSlug": "empresa-exemplo"
}

### Listar vagas com paginação e ordenação
GET {{baseUrl}}/vagas?pagina=0&tamanho=10&ordenarPor=publicadaEm&direcao=desc

### Listar as vagas de uma empresa
GET {{baseUrl}}/empresas/{{empresaSlug}}/vagas

### Buscar vaga por ID
GET {{baseUrl}}/vagas/{{vagaId}}

### Atualizar vaga
PUT {{baseUrl}}/vagas/{{vagaId}}
Content-Type: application/json

{
  "titulo": "Pessoa Desenvolvedora Java e Spring",
  "descricao": "Desenvolvimento de APIs REST com Java e Spring Boot.",
  "area": "BACK_END",
  "senioridade": "PLENO",
  "local": "Híbrido",
  "aceitaIniciante": false,
  "empresaSlug": "empresa-exemplo"
}

### Filtrar vagas (todos os parâmetros são opcionais)
GET {{baseUrl}}/vagas/busca?area=BACK_END&senioridade=PLENO&aceitaIniciante=false

### Busca avançada por empresa, local, data e ordenação
GET {{baseUrl}}/vagas/busca?empresaSlug={{empresaSlug}}&local=remoto&dataInicio=2026-01-01&dataFim=2026-12-31&ordenarPor=titulo&direcao=asc

### Consultar estatísticas
GET {{baseUrl}}/estatisticas

### Excluir vaga
DELETE {{baseUrl}}/vagas/{{vagaId}}

### Atualizar empresa
PUT {{baseUrl}}/empresas/{{empresaSlug}}
Content-Type: application/json

{
  "nome": "Empresa Exemplo Atualizada",
  "slug": "empresa-exemplo-atualizada",
  "site": "https://empresa-exemplo.com.br",
  "descricao": "Empresa de tecnologia com perfil atualizado."
}

### Excluir empresa (somente quando não possuir vagas)
DELETE {{baseUrl}}/empresas/{{empresaSlug}}

### Exemplo de validação com erro 400
POST {{baseUrl}}/vagas
Content-Type: application/json

{
  "titulo": "",
  "descricao": "",
  "area": null,
  "senioridade": null,
  "local": "",
  "aceitaIniciante": null,
  "empresaSlug": "Slug Inválido"
}
